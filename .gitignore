# Superpowers brainstorm companion
.superpowers/

# Supabase CLI scratch
# Migrations + seed ARE committed: this is now a website-only standalone DB,
# so this repo is the sole source of truth for the schema. (No secrets live
# in supabase/ — keys/passwords stay in the gitignored .env.)
.supabase/
.supabase-*.url
supabase/.temp/

# Playwright
test-results/
playwright-report/

# tests kept local only (not published to GitHub)
/tests/

.vscode/
.idea/

